{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cortrix.ai/schemas/demo-run-manifest-v1.json",
  "title": "Cortrix Demo Run Manifest",
  "type": "object",
  "required": ["schema_version", "run_id", "scenario_id", "state", "target_identity", "fixture_manifest_sha256", "provider_identity", "run_a", "run_b", "resolver", "cleanup", "cost", "claim_boundary"],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "scenario_id": {"const": "order-api-field-migration"},
    "state": {"enum": ["created", "running", "candidate", "accepted", "rejected"]},
    "target_identity": {"type": "object", "required": ["release", "release_commit", "source_revision", "container_digest"], "additionalProperties": true},
    "fixture_manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "provider_identity": {
      "type": "object",
      "required": ["provider", "model", "base_url", "local_generative_llm"],
      "properties": {
        "provider": {"const": "deepseek"},
        "model": {"const": "deepseek-v4-flash"},
        "base_url": {"const": "https://api.deepseek.com/v1"},
        "local_generative_llm": {"const": false}
      }
    },
    "run_a": {"type": "object"},
    "run_b": {"type": "object"},
    "resolver": {"type": "object"},
    "cleanup": {"type": "object"},
    "cost": {"type": "object"},
    "claim_boundary": {"type": "string", "minLength": 1}
  },
  "additionalProperties": true
}
