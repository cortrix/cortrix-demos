{
  "schema_version": 1,
  "project": "cortrix-demos",
  "purpose": "Discover, validate, replay, and extend evidence-backed Cortrix demos without private workspace knowledge.",
  "agent_first": {
    "principle": "Machine-readable contracts are the primary execution interface; human documentation and the Web viewer explain the same accepted evidence.",
    "default_mode": "accepted_replay",
    "default_external_calls": false,
    "fail_closed": true
  },
  "bootstrap": {
    "safe_default": [
      "./democtl list --json",
      "./democtl describe --scenario order-api-field-migration --json",
      "./democtl validate --scenario order-api-field-migration",
      "./democtl verify-accepted"
    ],
    "human_entry": "README.md",
    "agent_guide": "docs/agent-quickstart.md"
  },
  "catalogs": {
    "scenarios": "scenarios/registry.json",
    "adapters": "runtime/adapters/registry.json",
    "external_call_policy": "config/external-call-policy.json",
    "evidence_schema": "packages/evidence-schema/run-manifest.schema.json",
    "harness_evidence_schema": "packages/evidence-schema/harness-run-manifest.schema.json",
    "image_provenance": "runtime/image-provenance.json"
  },
  "lifecycle": [
    "discover",
    "describe",
    "validate",
    "preflight",
    "provision",
    "run",
    "inspect",
    "verify",
    "cleanup"
  ],
  "gates": {
    "live_full_stack": {
      "manual_authorization_required": true,
      "external_calls": true,
      "secret_resolution": {
        "precedence": ["declared_environment", "CORTRIX_LLM_SECRET_FILE", "user_default_profile"],
        "user_default_profile": "${XDG_CONFIG_HOME:-$HOME/.config}/cortrix/secrets/llm/current.yaml",
        "read_boundary": "authorized_preflight_only",
        "recorded_output": "source_class_only"
      },
      "source_preparation": "git clone https://github.com/cortrix/cortrix.git .runtime/cortrix-src",
      "image_preparation": "./democtl prepare-image --scenario order-api-field-migration",
      "command": "./democtl run-full-stack --scenario order-api-field-migration"
    },
    "deepseek_harness": {
      "manual_authorization_required": true,
      "external_calls": true,
      "scenarios": ["database-change-conflict-guardian", "api-version-drift-coding-agent", "payment-incident-shift-handoff", "migration-decision-recovery"],
      "safe_discovery": [
        "./democtl describe --scenario database-change-conflict-guardian --json",
        "./democtl validate --scenario database-change-conflict-guardian",
        "./democtl describe --scenario api-version-drift-coding-agent --json",
        "./democtl validate --scenario api-version-drift-coding-agent",
        "./democtl describe --scenario payment-incident-shift-handoff --json",
        "./democtl validate --scenario payment-incident-shift-handoff",
        "./democtl describe --scenario migration-decision-recovery --json",
        "./democtl validate --scenario migration-decision-recovery"
      ],
      "campaigns": {
        "foundation": "runtime/harness/campaigns/foundation.json",
        "operational_continuity": "runtime/harness/campaigns/operational-continuity.json"
      },
      "harness_source": "https://github.com/deepseek-ai/deepseek-harness",
      "harness_commit": "99f6f02fecdb7dff40c3fbc9470f5907c29f74ca",
      "harness_path": ".runtime/deepseek-harness",
      "harness_preparation": "git clone https://github.com/deepseek-ai/deepseek-harness.git .runtime/deepseek-harness && git -C .runtime/deepseek-harness checkout 99f6f02fecdb7dff40c3fbc9470f5907c29f74ca && npx --yes pnpm@11.7.0 --dir .runtime/deepseek-harness install --frozen-lockfile && npx --yes pnpm@11.7.0 --dir .runtime/deepseek-harness run build:lib:host",
      "integration_source": "https://github.com/cortrix/cortrix-integrations",
      "integration_commit": "ebb2b62cf620ce6fda9a7199fafb545bcb9a9f99",
      "integration_path": ".runtime/cortrix-integrations/integrations/deepseek-harness",
      "integration_preparation": "git clone https://github.com/cortrix/cortrix-integrations.git .runtime/cortrix-integrations && git -C .runtime/cortrix-integrations checkout ebb2b62cf620ce6fda9a7199fafb545bcb9a9f99 && npm --prefix .runtime/cortrix-integrations ci && npm --prefix .runtime/cortrix-integrations run validate",
      "live_command": "./democtl harness campaign --campaign-contract runtime/harness/campaigns/<campaign>.json --harness-root .runtime/deepseek-harness --plugin-root .runtime/cortrix-integrations/integrations/deepseek-harness --cortrix-root .runtime/cortrix-harness-src --pricing-snapshot .runs/pricing-snapshot.json",
      "comparison_variable": "cortrix_bundle_loaded",
      "model_tools": ["cortrix_search_evidence", "cortrix_get_source"],
      "model_write_tools": 0,
      "acceptance": "independent_clean_room_required",
      "accepted_viewer": "make viewer-harness SCENARIO=<scenario-id>"
    },
    "accepted_promotion": "independent_clean_run_required",
    "remote_publication": "explicit_human_authorization_required"
  }
}
